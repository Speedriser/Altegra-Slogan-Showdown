{
  "rules": {
    "rooms": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "$code.matches(/^[A-HJKMNP-Z]{4}$/)",
        "phase": {
          ".validate": "newData.isString() && newData.val().matches(/^(lobby|submission|bracket|voting|done)$/)"
        },
        "hostId": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "createdAt": {
          ".validate": "newData.isNumber() || newData.val() == null"
        },
        "players": {
          "$uid": {
            ".validate": "newData.hasChildren(['name','avatar'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
            },
            "avatar": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "$other": { ".validate": false }
          }
        },
        "submissions": {
          "$sid": {
            ".validate": "newData.hasChildren(['text','authorId'])",
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
            },
            "authorId": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "submittedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": { ".validate": false }
          }
        },
        "bracket": {
          ".validate": "newData.hasChild('rounds')"
        },
        "currentMatchup": {
          "roundIdx": { ".validate": "newData.isNumber()" },
          "matchupIdx": { ".validate": "newData.isNumber()" }
        },
        "votes": {
          "$mid": {
            "$uid": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            }
          }
        }
      }
    }
  }
}
